# ==========================================================
# IAMOS Environment Configuration - Production & Dev Hybrid
# ==========================================================

# --- Database & Event Bus (Internal Docker Mesh Routing) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=iamos
DATABASE_URL=postgresql://postgres:postgres@db:5432/iamos
REDIS_URL=redis://redis:6379/0

# --- Multi-Provider AI Engine ---
AI_PRIMARY_PROVIDER=google
AI_FALLBACK_PROVIDER=anthropic
AI_FALLBACK_PROVIDER_2=openai
AI_FALLBACK_PROVIDER_3=xai

# API Keys (Google Gemini Studio handles primary high-context chains)
GOOGLE_AI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_claude_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
XAI_API_KEY=your_grok_api_key_here

# --- Human-in-the-Loop & Mode 1 Publishing ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
MASTER_GROUP_CHAT_ID=-1001234567890

# --- Optional: Mode 2/3 Publishing Proxies ---
INSTAGRAM_PROXY_URL=http://proxy_user:proxy_pass@ir-proxy.local:8080
INSTAGRAM_PROXY_URL_BACKUP=http://proxy_user:proxy_pass@eu-proxy.local:8080

# --- Application Settings ---
LOG_LEVEL=INFO
ENVIRONMENT=development
TZ=Asia/Tehran
